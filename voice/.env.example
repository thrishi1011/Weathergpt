# WeatherGPT Voice Module — Environment Variables Template
# Copy this file to .env and add your Gemini API key:
#   cp .env.example .env

# Gemini API key for server-side audio transcription (POST /api/gemini-stt)
# Never commit the real API key to Git.
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Default Gemini model
GEMINI_MODEL=gemini-flash-latest

# Port for the Edge TTS + Gemini proxy server
PORT=5050
